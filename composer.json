{
    "name": "flownative/openidconnect-neos",
    "license": "MIT",
    "type": "neos-package",
    "description": "Sign in to the Neos backend with OpenID Connect",
    "support": {
        "email": "support@flownative.com"
    },
    "require": {
        "php": "8.3.* || 8.4.* || 8.5.*",
        "neos/neos": "^9.0",
        "flownative/openidconnect-client": "^6.1"
    },
    "require-dev": {
        "neos/contentgraph-doctrinedbaladapter": "^9.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Flownative\\OpenIdConnect\\Neos\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flownative\\OpenIdConnect\\Neos\\Tests\\": "Tests"
        }
    },
    "config": {
        "allow-plugins": {
            "neos/composer-plugin": true
        }
    }
}
